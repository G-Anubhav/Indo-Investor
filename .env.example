# Public, browser-safe values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Runtime identity. Production must set both values to production and use HTTPS URLs.
APP_ENVIRONMENT=development

# Existing contact-form mail configuration (server-only).
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=

# Server-only critical key used by guarded development tools and Phase 4 validated private-document upload/signed review URLs. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ENVIRONMENT=development
SUPABASE_SEED_CONFIRMATION=seed:your-project-ref
ALLOW_DEV_SEED=false
DEV_SEED_ADMIN_EMAIL=admin.hosted-dev@example.test
DEV_SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password
DEV_SEED_AFFILIATE_EMAIL=affiliate.hosted-dev@example.test
DEV_SEED_AFFILIATE_PASSWORD=replace-with-a-strong-development-password

# Phase 3 uses manual payment verification. No payment gateway variables are required.
